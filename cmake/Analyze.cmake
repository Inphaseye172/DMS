# Static analysis hooks (opt-in).
if(DMS_ENABLE_CLANG_TIDY)
  find_program(DMS_CLANG_TIDY_EXE NAMES clang-tidy)
  if(DMS_CLANG_TIDY_EXE)
    set(CMAKE_CXX_CLANG_TIDY "${DMS_CLANG_TIDY_EXE};--warnings-as-errors=*" CACHE STRING "" FORCE)
    message(STATUS "clang-tidy enabled: ${DMS_CLANG_TIDY_EXE}")
  else()
    message(WARNING "DMS_ENABLE_CLANG_TIDY=ON but clang-tidy was not found")
  endif()
endif()
function(dms_apply_analyze target)
  if(MSVC AND DMS_ENABLE_MSVC_ANALYZE)
    target_compile_options(${target} PRIVATE /analyze /analyze:external- /external:W0)
  endif()
endfunction()
