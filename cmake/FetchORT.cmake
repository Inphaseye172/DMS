# Downloads the pinned ONNX Runtime binary package (headers + runtime) at configure time.
# Versions and hashes are recorded in THIRD_PARTY.md. The engine does NOT link ORT: it loads the
# shared library at runtime (see engine/src/ort_loader.cpp), so only the headers are needed to compile.
set(DMS_ORT_VERSION "1.22.0" CACHE STRING "Pinned ONNX Runtime version")
set(DMS_ORT_DIR "" CACHE PATH "Directory of an extracted ONNX Runtime package (overrides the download)")

if(WIN32)
  set(_ort_pkg "onnxruntime-win-x64-gpu-${DMS_ORT_VERSION}")
  set(_ort_file "${_ort_pkg}.zip")
  set(_ort_sha256 "5b5241716b2628c1ab5e79ee620be767531021149ee68f30fc46c16263fb94dd")
else()
  set(_ort_pkg "onnxruntime-linux-x64-${DMS_ORT_VERSION}")
  set(_ort_file "${_ort_pkg}.tgz")
  set(_ort_sha256 "8344d55f93d5bc5021ce342db50f62079daf39aaafb5d311a451846228be49b3")
endif()
set(_ort_url "https://github.com/microsoft/onnxruntime/releases/download/v${DMS_ORT_VERSION}/${_ort_file}")

if(DMS_ORT_DIR STREQUAL "" AND DEFINED ENV{DMS_ORT_DIR})
  set(DMS_ORT_DIR "$ENV{DMS_ORT_DIR}")
endif()

if(DMS_ORT_DIR STREQUAL "")
  set(_ort_root "${CMAKE_BINARY_DIR}/_deps/ort")
  set(_ort_extracted "${_ort_root}/${_ort_pkg}")
  if(NOT EXISTS "${_ort_extracted}/include/onnxruntime_c_api.h")
    if(NOT DMS_FETCH_ORT)
      message(FATAL_ERROR "ONNX Runtime not found. Set DMS_ORT_DIR to an extracted ${_ort_pkg} package or enable DMS_FETCH_ORT.")
    endif()
    file(MAKE_DIRECTORY "${_ort_root}")
    set(_ort_archive "${_ort_root}/${_ort_file}")
    # Reuse a copy fetched by scripts/fetch-deps.* (same pinned file) if its hash matches.
    set(_ort_cached "${CMAKE_SOURCE_DIR}/build/_downloads/${_ort_file}")
    if(NOT EXISTS "${_ort_archive}" AND EXISTS "${_ort_cached}")
      file(SHA256 "${_ort_cached}" _ort_cached_hash)
      if(_ort_cached_hash STREQUAL _ort_sha256)
        message(STATUS "Using cached ${_ort_cached}")
        set(_ort_archive "${_ort_cached}")
      endif()
    endif()
    if(NOT EXISTS "${_ort_archive}")
      message(STATUS "Downloading ${_ort_url}")
      file(DOWNLOAD "${_ort_url}" "${_ort_archive}" EXPECTED_HASH SHA256=${_ort_sha256} SHOW_PROGRESS STATUS _st TLS_VERIFY ON)
      list(GET _st 0 _code)
      if(NOT _code EQUAL 0)
        file(REMOVE "${_ort_archive}")
        message(FATAL_ERROR "Failed to download ONNX Runtime: ${_st}")
      endif()
    endif()
    message(STATUS "Extracting ${_ort_file}")
    file(ARCHIVE_EXTRACT INPUT "${_ort_archive}" DESTINATION "${_ort_root}")
  endif()
  set(DMS_ORT_DIR "${_ort_extracted}")
endif()

if(NOT EXISTS "${DMS_ORT_DIR}/include/onnxruntime_c_api.h")
  message(FATAL_ERROR "DMS_ORT_DIR=${DMS_ORT_DIR} does not contain include/onnxruntime_c_api.h")
endif()
set(DMS_ORT_INCLUDE_DIR "${DMS_ORT_DIR}/include")
set(DMS_ORT_RUNTIME_DIR "${DMS_ORT_DIR}/lib")
message(STATUS "ONNX Runtime ${DMS_ORT_VERSION}: ${DMS_ORT_DIR}")
